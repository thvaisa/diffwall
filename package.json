{
  "name": "diffwall",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only, browser-based diff wall for watching coding agents work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thvaisa/diffwall.git"
  },
  "type": "module",
  "bin": {
    "diffwall": "dist/server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "dev:server": "npm run build:server && node --watch dist/server/index.js",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "markdown-it": "15.0.1",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
